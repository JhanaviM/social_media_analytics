# ═══════════════════════════════════════════════════════════
#  SMA Platform — Environment Variables
#  NEVER commit this file to GitHub (it is in .gitignore).
# ═══════════════════════════════════════════════════════════

# Flask Core
SECRET_KEY=change-this-to-a-long-random-string-abc123xyz

# Database — SQLite for local dev (zero setup)
DATABASE_URL=sqlite:///sma.db
# For production (Render/Railway), replace with:
# DATABASE_URL=postgresql://user:password@host:5432/sma_db

# Apify API — get your token at https://console.apify.com/account/integrations
# Free plan = $5/mo credit, enough for ~1000 tweet scrapes
APIFY_API_TOKEN=your-apify-token-here

# Actor links (used in data_loader.py):
# X Twitter scraper  → https://apify.com/apidojo/tweet-scraper
# Facebook scraper   → https://apify.com/apidojo/facebook-posts-scraper

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=run.py
